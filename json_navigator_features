import requests


class JSON_Navigator:
    undo_commands = ["back","clear"]

    
    def __init__(self, data):
        self.data = data
        self.history = []
        

    # Main
    def navigate(self):
        while True:
            # Update data
            current_data = self.get_current_data()

            # Dictionary
            if type(current_data) is dict:
                self.navigate_dictionary(current_data)

            # List
            elif type(current_data) is list:
                self.navigate_list(current_data)

            # Final value
            else:
                self.navigate_data(current_data)

    def navigate_dictionary(self, data):
        while True:
            # Display
            self.display_dictionary(data)
            self.display_commands()
            print(f"Your current history : {self.history}")

            user_input = input("\nType the keyname or type a command: ")
            
            if self.is_input_valid(user_input):
                self.execute_user_command(user_input)
                break

            print("\nInput a number or a valid command")
            continue


    def navigate_list(self, data):
        while True:
            try:
                # Display
                self.display_list(data)
                self.display_commands()
                print(f"Your current history : {self.history}")

                user_input = input("\nType the index number or type a command: ")

                if user_input in self.undo_commands:
                        self.execute_user_command(user_input)
                        break

                index = int(user_input)

                if self.is_input_valid(index):
                    self.execute_user_command(index)
                    break

                print("\nInput a number or a valid command")
            except ValueError:
                print("\nInput a number or a valid command")
    
           
            
    def navigate_data(self, data):
        while True:
            print(f"\nYour current history : {self.history}")
            print(f"Value: {data}\n")

            user_input = input("Type back or clear to return: ")

            if self.is_input_valid(user_input):
                self.execute_user_command(user_input)
                break
            else:
                print("\nInvalid input")
                continue


    def get_current_data(self):
        current_data = self.data

        for key_index in self.history:
            current_data = current_data[key_index]

        return current_data


    def is_input_valid(self,user_input):
        current_data = self.get_current_data()

        if  user_input in self.undo_commands and len(self.history) > 0:
            return True
        if type(current_data) is list and 0 <= user_input < len(current_data):
            return True
        if type(current_data) is dict and user_input in current_data:
            return True

        return False


    def execute_user_command(self, command):
        match command:
            case "back":
                self.history.pop()
            case "clear":
                self.history.clear()
            case _:
                self.history.append(command)


    def display_commands(self):
        print(f"Commands: {', '.join(self.undo_commands)}")


    def display_dictionary(self, data):
        print("\nKeys: ",end="")
        print(", ".join(data))
        print()


    def display_list(self, data):
        print("\nIndexes: ",end="")
        if len("data") == 0:
            print("0")
        else:
            print(f"0-{len(data)-1}")
        print()


def processing_url(link):
    try:
        response = requests.get(link)

        if response.status_code != 200:
            return False

        return response.json()

    except (requests.exceptions.RequestException, ValueError):
        return False


def inspect_json(data):
    navigator = JSON_Navigator(data)
    navigator.navigate()


def main():

    # Processing json
    while True:
        user_link = input("Put the website link: ").replace(" ", "")
        json_file = processing_url(user_link)

        if json_file is False:
            print("Wrong link or unstable connection")
            continue

        break

    inspect_json(json_file)


if __name__ == "__main__":
    main()